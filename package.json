{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun packages/lintmax/dist/cli.js check",
    "clean": "sh clean.sh",
    "fix": "bun packages/lintmax/dist/cli.js fix",
    "prepare": "bunx simple-git-hooks",
    "smoke": "turbo run smoke",
    "test": "turbo run test",
    "verify": "rm -rf node_modules bun.lock packages/*/node_modules packages/*/dist packages/*/.cache && bun i --ignore-scripts && bunx simple-git-hooks && bun run build && bun run fix && bun run check && bun run smoke && bun run test"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run verify && git add -u"
  },
  "devDependencies": {
    "lintmax": "workspace:*",
    "simple-git-hooks": "latest",
    "turbo": "latest"
  },
  "packageManager": "bun@1.3.11"
}
