{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build --output-logs=errors-only",
    "check": "bun packages/lintmax/dist/cli.js check",
    "clean": "sh clean.sh",
    "fix": "bun packages/lintmax/dist/cli.js fix",
    "gen": "cd apps/docs && fumadocs-mdx",
    "postinstall": "sherif",
    "prepare": "bunx simple-git-hooks",
    "smoke": "turbo smoke --output-logs=errors-only",
    "test": "turbo test --output-logs=errors-only",
    "verify": "rm -rf node_modules bun.lock packages/*/node_modules packages/*/dist packages/*/.cache && bun i --ignore-scripts && bunx simple-git-hooks && bun run build && bun run fix && bun run check && bun run smoke && bun run test"
  },
  "simple-git-hooks": {
    "pre-commit": "sh up.sh && git add -u"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/mdx": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "lintmax": "workspace:*",
    "postcss": "latest",
    "sherif": "latest",
    "simple-git-hooks": "latest",
    "tailwindcss": "latest",
    "turbo": "latest"
  },
  "packageManager": "bun@1.3.11"
}
