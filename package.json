{
  "name": "lintmax",
  "version": "0.0.20",
  "description": "Maximum strictness linting, formatting, and type-checking in one package",
  "keywords": [
    "biome",
    "eslint",
    "formatter",
    "lint",
    "linter",
    "oxlint",
    "prettier",
    "typecheck",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1qh/lintmax"
  },
  "license": "MIT",
  "author": "1qh",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    },
    "./tsconfig": "./tsconfig.json",
    "./tsconfig.json": "./tsconfig.json"
  },
  "bin": {
    "lintmax": "dist/cli.js"
  },
  "files": [
    "dist",
    "tsconfig.json",
    "oxlintrc.json"
  ],
  "scripts": {
    "build": "q bun run build:raw",
    "build:raw": "bun clean && bun install --silent && tsc -p tsconfig.build.json && printf '#!/usr/bin/env bun\\n' | cat - dist/cli.js > dist/cli.tmp && mv dist/cli.tmp dist/cli.js && chmod +x dist/cli.js",
    "check": "q bun dist/cli.js check",
    "ci": "q bun run build && q bun check && q bun run smoke",
    "clean": "rm -rf node_modules bun.lock dist .cache",
    "cleanup-old-versions": "bun script/cleanup-old-versions.ts",
    "fix": "q bun dist/cli.js fix",
    "postinstall": "bash script/q-install.sh",
    "postpublish": "bun run cleanup-old-versions",
    "release": "bun ci && q bun publish",
    "release:dry": "bun ci && q bun publish --dry-run",
    "smoke": "q bun script/smoke.ts"
  },
  "dependencies": {
    "@biomejs/biome": "latest",
    "@eslint-react/eslint-plugin": "^2",
    "@eslint/compat": "latest",
    "@eslint/js": "latest",
    "@next/eslint-plugin-next": "latest",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9",
    "eslint-plugin-better-tailwindcss": "latest",
    "eslint-plugin-perfectionist": "latest",
    "eslint-plugin-prefer-arrow-functions": "latest",
    "eslint-plugin-react": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-turbo": "latest",
    "oxlint": "latest",
    "prettier": "latest",
    "sort-package-json": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  }
}
