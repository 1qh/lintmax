{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "action": "sh up.sh && bun run test",
    "build": "bash -c \"turbo build --output-logs=errors-only 2> >(grep -vE 'WARNING|Could not resolve workspaces|missing field|Turborepo will still function' >&2)\"",
    "check": "bun packages/lintmax/dist/cli.mjs check",
    "clean": "sh clean.sh",
    "fix": "bun packages/lintmax/dist/cli.mjs fix",
    "gen": "cd apps/docs && fumadocs-mdx",
    "postinstall": "sherif",
    "prepare": "bunx simple-git-hooks",
    "smoke": "turbo smoke --output-logs=errors-only",
    "test": "turbo smoke test --output-logs=errors-only",
    "verify": "rm -rf node_modules bun.lock packages/*/node_modules packages/*/dist packages/*/.cache && bun i --ignore-scripts && bunx simple-git-hooks && bun run build && bun run fix && bun run check && bun run smoke && bun run test"
  },
  "simple-git-hooks": {
    "pre-commit": "sh up.sh && git add -u"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/mdx": "latest",
    "@types/node": "latest",
    "lintmax": "workspace:*",
    "sherif": "latest",
    "simple-git-hooks": "latest",
    "tsdown": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "unrun": "latest"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "lintmax",
    "msw",
    "sharp",
    "simple-git-hooks"
  ]
}
